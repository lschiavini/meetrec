#!/bin/zsh
# meetrec: everything the MeetRec panel does, from the terminal.
#
# Recording goes through MeetRec.app (launched headless with `open`), so it uses the app's
# Screen & System Audio Recording and Microphone permissions, not the terminal's.
set -euo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

HERE="${0:A:h}"
CONFIG="${MEETREC_CONFIG:-$HOME/.config/meetrec/config.json}"
STATE="${MEETREC_STATE:-$HOME/.config/meetrec/recording.status}"

usage() {
  cat <<'EOF'
usage: meetrec <command> [args]

Recording
  record [TITLE] [--for DURATION]   record in the foreground; Ctrl-C (or DURATION) stops and saves
  start [TITLE]                     start recording in the background, print the folder
  stop                              stop the background recording, save and mix it
  status                            is a recording running? (exit 1 if not)

Meetings (MEETING = folder name, unique part of it, a folder path, or "latest"; default latest)
  list                              every meeting, newest first ("*" = has a transcript)
  transcribe [MEETING|AUDIO_FILE]   mix and transcribe; an audio file is imported as a new meeting
  show [MEETING] [--mic]            print the transcript (--mic: your microphone only)
  name [MEETING] [--copy]           print "meeting: <name>" for an agent; --copy puts it on the clipboard
  path [MEETING]                    print the meeting folder
  rename MEETING TITLE              set the title (renames the folder, updates meta.json)
  log [MEETING]                     print the processing log
  open [MEETING]                    open the folder in Finder
  delete MEETING                    move the meeting to the Trash

Setup
  folder [DIR]                      print, or change, where new recordings go
  config [KEY [VALUE]]              print the config, one key, or set a key (string value)
  panel                             open the floating panel
  selftest [SECONDS]                record a few seconds to a temp folder, check both tracks
EOF
}

die() { print -u2 -r -- "meetrec: $*"; exit 1; }

# The app bundle: MEETREC_APP, the bundle this script sits in, or /Applications.
app() {
  if [[ -n "${MEETREC_APP:-}" ]]; then print -r -- "$MEETREC_APP"
  elif [[ "$HERE" == *.app/Contents/Resources ]]; then print -r -- "${HERE:h:h}"
  elif [[ -d /Applications/MeetRec.app ]]; then print -r -- /Applications/MeetRec.app
  elif [[ -d "${HERE:h}/build/MeetRec.app" ]]; then print -r -- "${HERE:h}/build/MeetRec.app"
  else die "MeetRec.app not found; run scripts/build-app.sh --install or set MEETREC_APP"
  fi
}

process_script() {
  if [[ -f "$HERE/process.sh" ]]; then print -r -- "$HERE/process.sh"
  else print -r -- "$(app)/Contents/Resources/process.sh"
  fi
}

need_config() { [[ -f "$CONFIG" ]] || die "missing $CONFIG (copy config.example.json there)"; }
cfg() { plutil -extract "$1" raw -o - "$CONFIG" 2>/dev/null || print -r -- "${2:-}"; }
root() { need_config; local r; r=$(cfg recordingsDir); print -r -- "${r/#\~/$HOME}"; }
slug() { print -r -- "$1" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//; s/-$//'; }

# Meeting folders, newest first.
meetings() {
  local r; r=$(root)
  [[ -d "$r" ]] || return 0
  local d
  for d in "$r"/*(N/On); do print -r -- "${d:t}"; done
}

# Resolves a MEETING argument to a folder path.
resolve() {
  local want="${1:-latest}" r; r=$(root)
  if [[ "$want" == latest ]]; then
    local first; first=$(meetings | head -1)
    [[ -n "$first" ]] || die "no meetings in $r"
    print -r -- "$r/$first"; return
  fi
  [[ -d "$want" && "$want" == */* ]] && { print -r -- "${want:A}"; return; }
  [[ -d "$r/$want" ]] && { print -r -- "$r/$want"; return; }
  want="${want#meeting: }"
  [[ -d "$r/$want" ]] && { print -r -- "$r/$want"; return; }
  local -a hits; hits=("${(@f)$(meetings | grep -F -- "$want" || true)}")
  hits=(${hits:#})
  (( ${#hits} == 1 )) && { print -r -- "$r/${hits[1]}"; return; }
  (( ${#hits} == 0 )) && die "no meeting matches '$want' (see: meetrec list)"
  die "'$want' matches ${#hits} meetings: ${(j:, :)hits}"
}

# Status file fields: state, then a folder or message, then the pid.
read_state() {
  state="" detail="" pid=""
  [[ -f "$STATE" ]] || return 0
  IFS=$'\t' read -r state detail pid < "$STATE" || true
}

# True while a recording runs; leaves its folder in $detail and its pid in $pid.
is_recording() {
  read_state
  [[ "$state" == recording && -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# Runs process.sh with its STAGE lines shown as progress.
run_process() {
  local script; script=$(process_script)
  /bin/zsh "$script" "$@" | while IFS= read -r line; do
    case "$line" in
      "STAGE: "*) print -u2 -r -- "==> ${line#STAGE: }" ;;
      "FAIL: "*) print -u2 -r -- "meetrec: ${line#FAIL: }" ;;
      "--- "*) ;;
      *) print -u2 -r -- "$line" ;;
    esac
  done
  return ${pipestatus[1]}
}

cmd_start() {
  local title="${1:-}"
  need_config
  if is_recording; then die "already recording into $detail (pid $pid); meetrec stop first"; fi
  mkdir -p "${STATE:h}"
  rm -f "$STATE"
  local a r; a=$(app); r=$(root)
  open -g -n -a "$a" --args --record --status "$STATE" --dir "$r" --name "$title"
  local i
  for i in {1..100}; do
    read_state
    case "$state" in
      recording) print -u2 -r -- "recording (pid $pid); stop with: meetrec stop"; print -r -- "$detail"; return 0 ;;
      failed) rm -f "$STATE"; die "$detail" ;;
    esac
    sleep 0.2
  done
  die "MeetRec did not start recording within 20 seconds"
}

cmd_stop() {
  is_recording || { rm -f "$STATE"; die "no recording running"; }
  local dir="$detail"
  kill -TERM "$pid"
  local i
  for i in {1..150}; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.2
  done
  read_state
  rm -f "$STATE"
  [[ "$state" == failed ]] && die "$detail"
  [[ "$state" == saved ]] || die "recorder did not confirm the save; check $dir"
  run_process "$dir" mix || die "saved, but mixing failed; see $dir/process.log"
  print -r -- "$dir"
}

seconds_of() {
  local v="$1"
  case "$v" in
    *h) print $(( ${v%h} * 3600 )) ;;
    *m) print $(( ${v%m} * 60 )) ;;
    *s) print $(( ${v%s} )) ;;
    <->) print "$v" ;;
    *) die "bad duration '$v' (use 90, 90s, 5m, 1h)" ;;
  esac
}

cmd_record() {
  local title="" limit=0
  while (( $# )); do
    case "$1" in
      --for) [[ -n "${2:-}" ]] || die "--for needs a duration"; limit=$(seconds_of "$2"); shift 2 ;;
      --for=*) limit=$(seconds_of "${1#--for=}"); shift ;;
      *) title="${title:+$title }$1"; shift ;;
    esac
  done
  local dir; dir=$(cmd_start "$title")
  local stopped=0
  TRAPINT() { stopped=1; return 0 }
  TRAPTERM() { stopped=1; return 0 }
  local began=$SECONDS
  while (( ! stopped )); do
    local e=$(( SECONDS - began ))
    [[ -t 2 ]] && printf '\r%d:%02d  Ctrl-C to stop ' $(( e / 60 )) $(( e % 60 )) >&2
    (( limit > 0 && e >= limit )) && break
    is_recording || { print -u2; die "recording ended on its own; see $dir/meta.json"; }
    sleep 1 || true
  done
  [[ -t 2 ]] && print -u2
  unfunction TRAPINT TRAPTERM
  cmd_stop
}

cmd_status() {
  if is_recording; then
    local started; started=$(plutil -extract startedAt raw -o - "$detail/meta.json" 2>/dev/null || true)
    print -r -- "recording ${detail:t} (pid $pid${started:+, since $started})"
    return 0
  fi
  print -r -- "not recording"
  return 1
}

cmd_list() {
  local r name; r=$(root)
  local active=""; if is_recording; then active="${detail:t}"; fi
  meetings | while IFS= read -r name; do
    if [[ "$name" == "$active" ]]; then print -r -- "● $name  (recording)"
    elif [[ -s "$r/$name/transcript.txt" ]]; then print -r -- "* $name"
    else print -r -- "  $name"
    fi
  done
}

cmd_transcribe() {
  local target="${1:-latest}"
  if [[ -f "$target" ]]; then
    run_process "${target:A}" transcribe
    # process.sh names the imported folder after the file's date and name.
    print -r -- "$(root)/$(date -r "$target" +%Y-%m-%d-%H%M)-$(slug "${target:t:r}")"
    return
  fi
  local dir; dir=$(resolve "$target")
  if is_recording && [[ "$detail" == "$dir" ]]; then die "${dir:t} is still recording; meetrec stop first"; fi
  run_process "$dir" transcribe || die "transcription failed; see: meetrec log ${dir:t}"
  print -r -- "$dir/transcript.txt"
}

cmd_show() {
  local which=transcript.txt arg=""
  for a in "$@"; do [[ "$a" == --mic ]] && which=transcript-mic.txt || arg="$a"; done
  local dir; dir=$(resolve "$arg")
  [[ -f "$dir/$which" ]] || die "${dir:t} has no $which yet; run: meetrec transcribe ${dir:t}"
  cat "$dir/$which"
}

cmd_name() {
  local copy=0 arg=""
  for a in "$@"; do [[ "$a" == --copy ]] && copy=1 || arg="$a"; done
  local dir; dir=$(resolve "$arg")
  local line="meeting: ${dir:t}"
  (( copy )) && { print -rn -- "$line" | pbcopy; print -u2 "copied"; }
  print -r -- "$line"
}

cmd_rename() {
  (( $# >= 2 )) || die "usage: meetrec rename MEETING TITLE"
  local dir; dir=$(resolve "$1"); shift
  local title="$*"
  if is_recording && [[ "$detail" == "$dir" ]]; then die "${dir:t} is still recording; rename it after meetrec stop"; fi
  local stamp="${${dir:t}[1,15]}" s; s=$(slug "$title")
  local wanted="$stamp${s:+-$s}" target="${dir:h}/$stamp${s:+-$s}"
  if [[ "$wanted" != "${dir:t}" ]]; then
    [[ -e "$target" ]] && die "$wanted already exists"
    mv "$dir" "$target"
    dir="$target"
  fi
  [[ -f "$dir/meta.json" ]] && plutil -replace title -string "$title" "$dir/meta.json"
  print -r -- "$dir"
}

cmd_log() {
  local dir; dir=$(resolve "${1:-}")
  [[ -f "$dir/process.log" ]] || die "${dir:t} has no log yet"
  cat "$dir/process.log"
}

cmd_delete() {
  [[ -n "${1:-}" ]] || die "usage: meetrec delete MEETING (name it; latest is not assumed)"
  local dir; dir=$(resolve "$1")
  if is_recording && [[ "$detail" == "$dir" ]]; then die "${dir:t} is still recording"; fi
  /usr/bin/trash "$dir"
  print -u2 -r -- "moved ${dir:t} to the Trash"
}

cmd_folder() {
  if [[ -z "${1:-}" ]]; then root; return; fi
  local dir="${1:A}"
  mkdir -p "$dir"
  cmd_config recordingsDir "${dir/#$HOME/~}" >/dev/null
  print -r -- "$dir"
}

cmd_config() {
  if [[ -z "${1:-}" ]]; then need_config; cat "$CONFIG"; print; return; fi
  if (( $# == 1 )); then need_config; plutil -extract "$1" raw -o - "$CONFIG"; return; fi
  mkdir -p "${CONFIG:h}"
  [[ -f "$CONFIG" ]] || print '{}' > "$CONFIG"
  # plutil would escape every slash in paths; the system python keeps the file readable.
  local key="$1"; shift
  /usr/bin/python3 -I - "$CONFIG" "$key" "$*" <<'PY'
import json, sys
path, key, value = sys.argv[1:]
with open(path) as f:
    data = json.load(f)
data[key] = value
with open(path, "w") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
PY
  print -r -- "$key = $*"
}

cmd_selftest() {
  local seconds="${1:-5}" dir; dir=$(mktemp -d /tmp/meetrec-selftest.XXXXXX)
  local statusfile="$dir/status"
  open -g -n -W -a "$(app)" --args --record --status "$statusfile" --dir "$dir" &
  local opener=$!
  local i state="" detail="" pid=""
  for i in {1..100}; do
    [[ -f "$statusfile" ]] && IFS=$'\t' read -r state detail pid < "$statusfile"
    [[ "$state" == recording || "$state" == failed ]] && break
    sleep 0.2
  done
  [[ "$state" == recording ]] || { wait $opener 2>/dev/null; die "selftest: ${detail:-no answer from MeetRec}"; }
  sleep "$seconds"
  kill -TERM "$pid"
  wait $opener 2>/dev/null || true
  IFS=$'\t' read -r state detail pid < "$statusfile"
  [[ "$state" == saved ]] || die "selftest: $detail"
  plutil -p "$detail/meta.json"
  ls -l "$detail"
}

command="${1:-help}"
(( $# )) && shift
case "$command" in
  record) cmd_record "$@" ;;
  start) cmd_start "$*" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  list|ls) cmd_list ;;
  transcribe|process) cmd_transcribe "$@" ;;
  show|cat) cmd_show "$@" ;;
  name|copy) [[ "$command" == copy ]] && set -- "$@" --copy; cmd_name "$@" ;;
  path) resolve "${1:-}" ;;
  rename) cmd_rename "$@" ;;
  log) cmd_log "$@" ;;
  open) open "$(resolve "${1:-}")" ;;
  delete|rm) cmd_delete "$@" ;;
  folder) cmd_folder "$@" ;;
  config) cmd_config "$@" ;;
  panel) open -a "$(app)" ;;
  selftest) cmd_selftest "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
